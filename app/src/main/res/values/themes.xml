<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- DayNight so the window background follows system dark mode before Compose draws its first frame. -->
    <style name="Theme.Klover" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
    </style>
</resources>
